PORT=4000
NODE_ENV=development

# Postgres (pgvector). Matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql://innerverse:innerverse@localhost:5432/innerverse

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Must stay true (or unset) in production, only flip to false locally if
# you need to sign in without a working mail provider configured below.
REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth (created manually in Google Cloud Console, see CLAUDE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude, called through OpenRouter (OpenAI-compatible endpoint), used for
# analysis, profile merge, and narrative summaries. Get a key at
# openrouter.ai/keys, model is any OpenRouter Claude slug (e.g. anthropic/claude-3.5-sonnet)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Voyage AI, used for entry embeddings (pgvector)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Outbound email for verification / password reset (any SMTP provider works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Innerverse <no-reply@innerverse.app>"
