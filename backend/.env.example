PORT=4000
NODE_ENV=development

# Postgres (pgvector). Matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql://innerverse:innerverse@localhost:5432/innerverse

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Must stay true (or unset) in production, only flip to false locally if
# you need to sign in without a working mail provider configured below.
REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth (created manually in Google Cloud Console, see CLAUDE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini, primary LLM for entry analysis, About Me, and profile merge (see
# UPDATES.md "model provider decision"). Free tier, no credit card, native
# structured JSON output. Get a key at aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude, called through OpenRouter (OpenAI-compatible endpoint). No longer
# the primary path (kept OpenRouter credit from running out too easily), now
# a manual fallback only, reachable by pointing services/analysis.js and
# services/profileMerge.js back at callClaudeJson (services/claude.js) if
# Gemini's free daily quota is ever hit. Get a key at openrouter.ai/keys,
# model is any OpenRouter Claude slug (e.g. anthropic/claude-3.5-sonnet)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Cheaper model for the high volume, low stakes background calls (profile
# merge on every entry). Falls back to OPENROUTER_MODEL if unset. The
# flagship model above is kept for the deep analysis the user actually reads.
OPENROUTER_MODEL_CHEAP=anthropic/claude-haiku-4.5

# Voyage AI, used for entry embeddings (pgvector)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Outbound email for verification / password reset (any SMTP provider works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Innerverse <no-reply@innerverse.app>"
